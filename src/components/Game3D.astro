---
// Game3D.astro - a FIRST-PERSON, PS1-style renderer over the SAME engine the
// 2D table uses. It reads GameState and draws a 3D scene; no game logic lives
// here. Character + hand models are deliberate low-poly placeholders for now.
//
// PS1 look = low internal render resolution upscaled with nearest-neighbour
// (CSS `image-rendering: pixelated`), no anti-aliasing, vertex "snapping"
// jitter, per-vertex (Gouraud) lighting, and fog. Lit bright + warm and
// playful rather than the dark Buckshot-Roulette mood.
---
<div class="scene3d" id="scene3d">
  <div class="scene3d-canvas" id="scene3d-canvas"></div>
  <div class="scene3d-ui">
    <span class="scene3d-title">UNOKER&nbsp;3D</span>
    <span class="scene3d-hand" id="scene3d-hand">dealing…</span>
    <button class="scene3d-btn" id="scene3d-deal" type="button">Deal again</button>
  </div>
  <div class="scene3d-loading" id="scene3d-loading">booting the PlayStation…</div>
</div>

<script>
  import * as THREE from "three";
  import {
    startGame,
    faceLabel,
    faceColorClass,
    evaluateHand,
    type Card,
    type GameState,
  } from "../engine/index";

  const mount = document.getElementById("scene3d-canvas");
  const loadingEl = document.getElementById("scene3d-loading");
  const handEl = document.getElementById("scene3d-hand");
  const dealBtn = document.getElementById("scene3d-deal");
  const root = document.getElementById("scene3d");

  // brand hues, matching the 2D cards
  const HEX: Record<string, string> = {
    red: "#b01e35",
    green: "#73aa2c",
    blue: "#075ca9",
    yellow: "#ead426",
    wild: "#1e1e1e",
    copy: "#1e1e1e",
  };

  if (mount && root) {
    try {
      run(mount, root);
    } catch (err) {
      if (loadingEl) {
        loadingEl.textContent =
          "Your browser couldn't start WebGL for the 3D table. The 2D game at /play works everywhere.";
      }
      console.error("UNOKER 3D failed to start:", err);
    }
  }

  function run(mount: HTMLElement, root: HTMLElement) {
    // ---- renderer (low-res, no AA -> the pixelated PS1 base) -------------
    const renderer = new THREE.WebGLRenderer({
      antialias: false,
      powerPreference: "low-power",
      preserveDrawingBuffer: true, // lets the frame be read back / screenshotted
    });
    renderer.setPixelRatio(1);
    mount.appendChild(renderer.domElement);

    const PIXEL = 4; // internal render = on-screen / PIXEL, then upscaled
    function sizeRenderer() {
      const w = Math.max(1, Math.floor(root.clientWidth / PIXEL));
      const h = Math.max(1, Math.floor(root.clientHeight / PIXEL));
      renderer.setSize(w, h, false); // false: keep CSS size (canvas is 100%)
      camera.aspect = root.clientWidth / root.clientHeight;
      camera.updateProjectionMatrix();
    }

    // ---- scene: bright, warm, playful -----------------------------------
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x6b8fb5);
    scene.fog = new THREE.Fog(0x6b8fb5, 6, 13);

    const camera = new THREE.PerspectiveCamera(68, 4 / 3, 0.1, 60);
    const LOOK = new THREE.Vector3(0, 0.95, 0);
    const CAM_BASE = new THREE.Vector3(0, 1.28, 2.0);

    scene.add(new THREE.AmbientLight(0xfff1d9, 1.05));
    const key = new THREE.PointLight(0xfff0c0, 0.9, 22, 2);
    key.position.set(0, 3.2, 0.6);
    scene.add(key);
    const fill = new THREE.DirectionalLight(0x9fd0ff, 0.5);
    fill.position.set(-3, 2, 3);
    scene.add(fill);

    // ---- PS1 vertex jitter: snap projected vertices to a coarse grid -----
    const ps1 = (m: THREE.Material) => {
      (m as any).onBeforeCompile = (shader: any) => {
        shader.vertexShader = shader.vertexShader.replace(
          "#include <project_vertex>",
          `#include <project_vertex>
           {
             vec2 grid = vec2(120.0, 90.0);
             gl_Position.xy = floor((gl_Position.xy / gl_Position.w) * grid) / grid * gl_Position.w;
           }`,
        );
      };
      return m;
    };
    const lambert = (color: number) => ps1(new THREE.MeshLambertMaterial({ color }));

    // ---- the room + table -----------------------------------------------
    const floor = new THREE.Mesh(new THREE.PlaneGeometry(30, 30), lambert(0x6a4a36));
    floor.rotation.x = -Math.PI / 2;
    scene.add(floor);

    const tableTop = new THREE.Mesh(
      new THREE.CylinderGeometry(1.35, 1.35, 0.12, 18),
      lambert(0x2e8b4f), // felt green
    );
    tableTop.position.y = 0.78;
    scene.add(tableTop);
    const tableRim = new THREE.Mesh(
      new THREE.CylinderGeometry(1.45, 1.45, 0.2, 18),
      lambert(0x5a3a22), // wooden rim
    );
    tableRim.position.y = 0.7;
    scene.add(tableRim);
    const pedestal = new THREE.Mesh(new THREE.CylinderGeometry(0.25, 0.4, 0.7, 10), lambert(0x5a3a22));
    pedestal.position.y = 0.35;
    scene.add(pedestal);

    // a little pot of chips in the middle, for life
    const chipColors = [0xd83b46, 0x2f6fd0, 0x37b24d, 0xf2c037];
    for (let i = 0; i < 10; i++) {
      const chip = new THREE.Mesh(
        new THREE.CylinderGeometry(0.09, 0.09, 0.02, 12),
        lambert(chipColors[i % chipColors.length]),
      );
      chip.position.set((i % 2) * 0.12 - 0.06, 0.85 + Math.floor(i / 2) * 0.022, -0.1);
      scene.add(chip);
    }

    // ---- goofy opponents: low-poly homage characters --------------------
    // Built facing +Z; seated behind the table. A roster (below) randomly
    // picks which ones sit down each deal, so the table changes every game.
    const arena = new THREE.Group();
    scene.add(arena);
    const SEATS = [
      { x: -1.15, z: -1.0 },
      { x: 0, z: -1.62 },
      { x: 1.15, z: -1.0 },
    ];

    // a cartoon eyeball (unlit so it stays bright)
    function eye(x: number, y: number, z: number): THREE.Group {
      const e = new THREE.Group();
      const white = new THREE.Mesh(
        new THREE.SphereGeometry(0.055, 8, 6),
        new THREE.MeshBasicMaterial({ color: 0xffffff }),
      );
      const pupil = new THREE.Mesh(
        new THREE.SphereGeometry(0.028, 6, 5),
        new THREE.MeshBasicMaterial({ color: 0x111111 }),
      );
      pupil.position.z = 0.04;
      e.add(white, pupil);
      e.position.set(x, y, z);
      return e;
    }

    function buildScooby(): THREE.Group {
      const g = new THREE.Group();
      const TAN = 0xcd9a5b;
      const DARK = 0x4a3320;
      const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.3, 0.45, 4, 10), lambert(TAN));
      body.position.set(0, 1.05, 0);
      body.scale.set(1, 1, 0.85);
      g.add(body);
      [[-0.12, 1.32, -0.16], [0.14, 1.2, -0.18], [0.02, 1.45, -0.14]].forEach((p) => {
        const spot = new THREE.Mesh(new THREE.SphereGeometry(0.09, 8, 6), lambert(DARK));
        spot.position.set(p[0], p[1], p[2]);
        spot.scale.set(1, 1, 0.4);
        g.add(spot);
      });
      const head = new THREE.Mesh(new THREE.SphereGeometry(0.26, 12, 10), lambert(TAN));
      head.position.set(0, 1.62, 0.05);
      g.add(head);
      const snout = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.16, 0.26), lambert(TAN));
      snout.position.set(0, 1.55, 0.28);
      g.add(snout);
      const nose = new THREE.Mesh(new THREE.SphereGeometry(0.06, 8, 6), lambert(0x141414));
      nose.position.set(0, 1.57, 0.42);
      g.add(nose);
      [-1, 1].forEach((s) => {
        const ear = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.26, 0.14), lambert(DARK));
        ear.position.set(s * 0.24, 1.55, -0.02);
        ear.rotation.z = s * 0.4;
        g.add(ear);
      });
      g.add(eye(-0.09, 1.71, 0.23), eye(0.09, 1.71, 0.23));
      const collar = new THREE.Mesh(new THREE.TorusGeometry(0.22, 0.05, 6, 12), lambert(0x18a0e0));
      collar.position.set(0, 1.4, 0.02);
      collar.rotation.x = Math.PI / 2;
      g.add(collar);
      const tag = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.1, 0.03), lambert(0xe8d24a));
      tag.position.set(0, 1.31, 0.2);
      tag.rotation.z = Math.PI / 4;
      g.add(tag);
      return g;
    }

    function buildLeftShark(): THREE.Group {
      const g = new THREE.Group();
      const BLUE = 0x6fb7e0;
      const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.34, 0.5, 5, 12), lambert(BLUE));
      body.position.set(0, 1.15, 0);
      body.scale.set(1, 1, 0.9);
      g.add(body);
      const belly = new THREE.Mesh(new THREE.SphereGeometry(0.26, 10, 8), lambert(0xeaf3f8));
      belly.position.set(0, 1.0, 0.18);
      belly.scale.set(0.8, 1.1, 0.5);
      g.add(belly);
      const snout = new THREE.Mesh(new THREE.SphereGeometry(0.3, 12, 10), lambert(BLUE));
      snout.position.set(0, 1.56, 0.04);
      g.add(snout);
      const mouth = new THREE.Mesh(new THREE.BoxGeometry(0.34, 0.1, 0.06), lambert(0x33202c));
      mouth.position.set(0, 1.46, 0.27);
      g.add(mouth);
      for (let i = 0; i < 5; i++) {
        const tooth = new THREE.Mesh(
          new THREE.ConeGeometry(0.025, 0.06, 4),
          new THREE.MeshBasicMaterial({ color: 0xffffff }),
        );
        tooth.position.set(-0.12 + i * 0.06, 1.49, 0.29);
        tooth.rotation.x = Math.PI;
        g.add(tooth);
      }
      const fin = new THREE.Mesh(new THREE.ConeGeometry(0.12, 0.3, 4), lambert(BLUE));
      fin.position.set(0, 1.98, -0.16);
      fin.rotation.x = -0.5;
      g.add(fin);
      [-1, 1].forEach((s) => {
        const f = new THREE.Mesh(new THREE.ConeGeometry(0.1, 0.34, 4), lambert(BLUE));
        f.position.set(s * 0.42, 1.02, 0.05);
        f.rotation.z = (s * Math.PI) / 2.2;
        f.rotation.x = 0.3;
        g.add(f);
      });
      g.add(eye(-0.12, 1.72, 0.24), eye(0.12, 1.72, 0.24));
      g.rotation.z = 0.05; // a little goofy lean
      return g;
    }

    function buildBurnie(): THREE.Group {
      const g = new THREE.Group();
      const ORANGE = 0xef6c1a;
      const FLAME = 0xffb02e;
      const torso = new THREE.Mesh(new THREE.CapsuleGeometry(0.34, 0.4, 4, 10), lambert(0x141414));
      torso.position.set(0, 1.1, 0);
      g.add(torso);
      const trim = new THREE.Mesh(new THREE.TorusGeometry(0.3, 0.04, 6, 14), lambert(0xe4002b));
      trim.position.set(0, 1.34, 0);
      trim.rotation.x = Math.PI / 2;
      g.add(trim);
      [-1, 1].forEach((s) => {
        const arm = new THREE.Mesh(new THREE.CapsuleGeometry(0.1, 0.3, 3, 6), lambert(ORANGE));
        arm.position.set(s * 0.4, 1.05, 0.05);
        arm.rotation.z = s * 0.5;
        g.add(arm);
      });
      const head = new THREE.Mesh(new THREE.SphereGeometry(0.36, 14, 12), lambert(ORANGE));
      head.position.set(0, 1.8, 0.02);
      g.add(head);
      [-0.15, 0.0, 0.15].forEach((dx, i) => {
        const tall = i === 1;
        const fl = new THREE.Mesh(new THREE.ConeGeometry(0.1, tall ? 0.42 : 0.3, 5), lambert(tall ? 0xffd24d : FLAME));
        fl.position.set(dx, tall ? 2.24 : 2.16, -0.02);
        g.add(fl);
      });
      const nose = new THREE.Mesh(new THREE.SphereGeometry(0.1, 10, 8), lambert(0x2faa3a));
      nose.position.set(0, 1.76, 0.34);
      g.add(nose);
      g.add(eye(-0.14, 1.93, 0.29), eye(0.14, 1.93, 0.29));
      const grin = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.06, 0.05), lambert(0x5a1a10));
      grin.position.set(0, 1.63, 0.31);
      g.add(grin);
      return g;
    }

    // floating retro name tag above each character
    function makeLabel(text: string): THREE.Sprite {
      const c = document.createElement("canvas");
      c.width = 256;
      c.height = 64;
      const x = c.getContext("2d")!;
      x.fillStyle = "rgba(0,0,0,0.5)";
      x.fillRect(0, 0, 256, 64);
      x.font = '900 30px "Comic Sans MS", cursive, sans-serif';
      x.textAlign = "center";
      x.textBaseline = "middle";
      x.lineWidth = 5;
      x.strokeStyle = "#000000";
      x.strokeText(text, 128, 35);
      x.fillStyle = "#ffd400";
      x.fillText(text, 128, 35);
      const t = new THREE.CanvasTexture(c);
      t.magFilter = THREE.NearestFilter;
      t.minFilter = THREE.NearestFilter;
      const s = new THREE.Sprite(new THREE.SpriteMaterial({ map: t, transparent: true, depthTest: false }));
      s.scale.set(1.05, 0.26, 1);
      return s;
    }

    function disposeGroup(o: THREE.Object3D) {
      o.traverse((n: any) => {
        if (n.geometry) n.geometry.dispose();
        const m = n.material;
        if (m) (Array.isArray(m) ? m : [m]).forEach((mm: any) => { if (mm.map) mm.map.dispose(); mm.dispose(); });
      });
    }

    function placeOpponents(chosen: { name: string; build: () => THREE.Group }[]) {
      arena.children.slice().forEach(disposeGroup);
      arena.clear();
      const backTex = makeBackTexture();
      chosen.forEach((c, i) => {
        const seat = SEATS[i];
        if (!seat) return;
        const g = c.build();
        g.position.set(seat.x, 0, seat.z);
        g.rotation.y = Math.atan2(-seat.x, -seat.z); // face the table centre
        for (let k = 0; k < 2; k++) {
          const back = new THREE.Mesh(
            new THREE.PlaneGeometry(0.16, 0.24),
            new THREE.MeshBasicMaterial({ map: backTex }),
          );
          back.position.set((k - 0.5) * 0.2, 0.84, 0.62);
          back.rotation.x = -Math.PI / 2.05;
          g.add(back);
        }
        const label = makeLabel(c.name);
        label.position.set(0, 2.5, 0);
        g.add(label);
        arena.add(g);
      });
    }

    // ---- first-person: our own hands + our cards, parented to the camera -
    const handRig = new THREE.Group();
    camera.add(handRig);
    scene.add(camera);

    const skin = lambert(0xe0a878);
    const makeHand = (side: number) => {
      const hand = new THREE.Group();
      const palm = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.05, 0.18), skin);
      hand.add(palm);
      for (let f = 0; f < 4; f++) {
        const finger = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.04, 0.11), skin);
        finger.position.set((f - 1.5) * 0.04, 0, -0.14);
        hand.add(finger);
      }
      const thumb = new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.04, 0.08), skin);
      thumb.position.set(side * 0.1, 0, -0.04);
      hand.add(thumb);
      hand.position.set(side * 0.34, -0.42, -0.62);
      hand.rotation.set(-0.9, side * -0.25, side * 0.2);
      return hand;
    };
    handRig.add(makeHand(-1), makeHand(1));

    // the fan of our cards (rebuilt every deal)
    const fan = new THREE.Group();
    fan.position.set(0, -0.34, -0.58);
    fan.rotation.x = -0.5;
    handRig.add(fan);

    function makeCardMesh(card: Card): THREE.Mesh {
      const klass = faceColorClass(card);
      const tex = makeCardTexture(faceLabel(card), HEX[klass] ?? "#1e1e1e");
      const mat = new THREE.MeshBasicMaterial({ map: tex });
      return new THREE.Mesh(new THREE.PlaneGeometry(0.16, 0.24), mat);
    }

    function showHand(cards: Card[]) {
      fan.clear();
      const n = cards.length;
      cards.forEach((card, i) => {
        const m = makeCardMesh(card);
        const t = n > 1 ? i / (n - 1) - 0.5 : 0; // -0.5 .. 0.5
        m.position.set(t * 0.26, Math.abs(t) * -0.05, -Math.abs(t) * 0.02);
        m.rotation.z = -t * 0.5;
        fan.add(m);
      });
    }

    // ---- roster: who sits down is randomised each deal ------------------
    // Only three for now, but the table picks a random 2-3 of them in random
    // seats, so you don't face the same line-up every time. Add more entries
    // here and the variety grows automatically.
    type RosterEntry = { name: string; build: () => THREE.Group };
    const ROSTER: RosterEntry[] = [
      { name: "Left Shark", build: buildLeftShark },
      { name: "Scooby-Doo", build: buildScooby },
      { name: "Burnie", build: buildBurnie },
    ];
    function pickOpponents(): RosterEntry[] {
      const s = ROSTER.slice();
      for (let i = s.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [s[i], s[j]] = [s[j], s[i]];
      }
      const n = Math.min(SEATS.length, ROSTER.length, 2 + Math.floor(Math.random() * 2)); // 2 or 3
      return s.slice(0, n);
    }

    let game: GameState;
    function newRound() {
      const chosen = pickOpponents();
      game = startGame({
        players: [
          { name: "You", isBot: false },
          ...chosen.map((c) => ({ name: c.name, isBot: true })),
        ],
        startingChips: 200,
        minBet: 10,
        seed: (Date.now() & 0x7fffffff) >>> 0,
      });
      placeOpponents(chosen);
      const hand = game.players[0].hand;
      showHand(hand);
      if (handEl) {
        const cat = hand.length === 5 ? evaluateHand(hand).category.name : "—";
        handEl.textContent = `Your hand: ${cat}`;
      }
    }
    newRound();

    dealBtn?.addEventListener("click", newRound);

    // ---- drag to look around (yaw/pitch around the table) ---------------
    let yaw = 0;
    let pitch = 0;
    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    root.addEventListener("pointerdown", (e) => {
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
    });
    window.addEventListener("pointerup", () => (dragging = false));
    window.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      yaw = Math.max(-0.7, Math.min(0.7, yaw - (e.clientX - lastX) * 0.004));
      pitch = Math.max(-0.35, Math.min(0.4, pitch + (e.clientY - lastY) * 0.004));
      lastX = e.clientX;
      lastY = e.clientY;
    });

    // ---- loop -----------------------------------------------------------
    // Re-size from the loop so it self-heals if the container has no layout
    // width yet at startup (and handles window resizes for free).
    let lastW = -1;
    let lastH = -1;
    const clock = new THREE.Clock();
    function frame() {
      const cw = root.clientWidth;
      const ch = root.clientHeight;
      if (cw > 0 && ch > 0 && (cw !== lastW || ch !== lastH)) {
        lastW = cw;
        lastH = ch;
        sizeRenderer();
      }
      const t = clock.getElapsedTime();
      const bob = Math.sin(t * 1.3) * 0.012;
      camera.position.set(
        CAM_BASE.x + Math.sin(yaw) * 0.6,
        CAM_BASE.y + bob,
        CAM_BASE.z,
      );
      const look = new THREE.Vector3(
        LOOK.x + Math.sin(yaw) * 1.4,
        LOOK.y + pitch,
        LOOK.z - Math.cos(yaw) * 0.2,
      );
      camera.lookAt(look);
      renderer.render(scene, camera);
      requestAnimationFrame(frame);
    }
    frame();

    // Size + draw a frame whenever the container resizes - independent of
    // requestAnimationFrame, so it works even before the first animation frame.
    const ro = new ResizeObserver(() => {
      if (root.clientWidth > 0 && root.clientHeight > 0) {
        sizeRenderer();
        renderer.render(scene, camera);
      }
    });
    ro.observe(root);

    if (loadingEl) loadingEl.style.display = "none";
    (window as any).__u3d = { ok: true, objects: scene.children.length };
  }

  // ---- low-res canvas textures (nearest-filtered) -----------------------
  function makeCardTexture(label: string, faceHex: string): THREE.Texture {
    const c = document.createElement("canvas");
    c.width = 64;
    c.height = 96;
    const x = c.getContext("2d")!;
    x.fillStyle = "#eaeaec";
    x.fillRect(0, 0, 64, 96);
    x.fillStyle = faceHex;
    x.fillRect(4, 6, 56, 84);
    x.save();
    x.translate(32, 48);
    x.rotate(-0.34);
    x.strokeStyle = "#eaeaec";
    x.lineWidth = 4;
    x.beginPath();
    x.ellipse(0, 0, 15, 33, 0, 0, Math.PI * 2);
    x.stroke();
    x.restore();
    x.textAlign = "center";
    x.textBaseline = "middle";
    x.lineWidth = 4;
    x.strokeStyle = "#1e1e1e";
    x.fillStyle = "#eaeaec";
    x.font = "900 32px Arial";
    x.strokeText(label, 32, 49);
    x.fillText(label, 32, 49);
    x.font = "900 13px Arial";
    x.strokeText(label, 11, 13);
    x.fillText(label, 11, 13);
    return finishTexture(c);
  }

  function makeBackTexture(): THREE.Texture {
    const c = document.createElement("canvas");
    c.width = 64;
    c.height = 96;
    const x = c.getContext("2d")!;
    x.fillStyle = "#eaeaec";
    x.fillRect(0, 0, 64, 96);
    x.fillStyle = "#1e1e1e";
    x.fillRect(4, 6, 56, 84);
    x.save();
    x.translate(32, 48);
    x.rotate(-0.34);
    x.fillStyle = "#b01e35";
    x.beginPath();
    x.ellipse(0, 0, 15, 33, 0, 0, Math.PI * 2);
    x.fill();
    x.restore();
    x.fillStyle = "#eaeaec";
    x.font = "900 26px Arial";
    x.textAlign = "center";
    x.textBaseline = "middle";
    x.fillText("U", 32, 49);
    return finishTexture(c);
  }

  function finishTexture(c: HTMLCanvasElement): THREE.Texture {
    const t = new THREE.CanvasTexture(c);
    t.magFilter = THREE.NearestFilter;
    t.minFilter = THREE.NearestFilter;
    t.generateMipmaps = false;
    t.colorSpace = THREE.SRGBColorSpace;
    return t;
  }
</script>
